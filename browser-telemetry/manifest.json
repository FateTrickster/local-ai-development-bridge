{
  "manifest_version": 3,
  "name": "Local AI Bridge Telemetry",
  "version": "0.1.0",
  "description": "Roughly estimates ChatGPT Web output tokens/TPS and reports them to the local Local AI Bridge dashboard.",
  "host_permissions": [
    "http://127.0.0.1/*",
    "http://localhost/*"
  ],
  "background": {
    "service_worker": "service-worker.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://chatgpt.com/*",
        "https://chat.openai.com/*"
      ],
      "js": ["content-script.js"],
      "run_at": "document_idle"
    }
  ]
}
